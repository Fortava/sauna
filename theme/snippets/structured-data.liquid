{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign org_url = shop.url
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ brand | json }},
  "url": {{ org_url | json }},
  "description": {{ settings.seo_home_description | default: shop.description | strip_html | truncate: 300 | json }},
  {% if settings.share_image != blank %}
  "logo": {
    "@type": "ImageObject",
    "url": {{ settings.share_image | image_url: width: 512 | prepend: 'https:' | json }}
  },
  {% elsif settings.favicon != blank %}
  "logo": {
    "@type": "ImageObject",
    "url": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }}
  },
  {% endif %}
  "sameAs": [{% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}{% if settings.social_instagram != blank and settings.social_twitter_url != blank %},{% endif %}{% if settings.social_twitter_url != blank %}{{ settings.social_twitter_url | json }}{% endif %}],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "AU"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ brand | json }},
  "url": {{ org_url | json }},
  "publisher": {
    "@type": "Organization",
    "name": {{ brand | json }}
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ org_url | append: '/search?q={search_term_string}' | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' or request.page_type == 'blog' or request.page_type == 'page' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ brand | json }},
      "item": {{ org_url | json }}
    }
    {%- if request.page_type == 'product' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ org_url | append: product.url | json }}
    }
    {%- elsif request.page_type == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ org_url | append: collection.url | json }}
    }
    {%- elsif request.page_type == 'blog' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ org_url | append: blog.url | json }}
    }
    {%- elsif request.page_type == 'article' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ org_url | append: blog.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": {{ org_url | append: article.url | json }}
    }
    {%- elsif request.page_type == 'page' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ page.title | json }},
      "item": {{ org_url | append: page.url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{% if request.page_type == 'product' and product %}
  {%- liquid
    assign product_images = product.media | where: 'media_type', 'image'
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 5000 | json }},
    "url": {{ org_url | append: product.url | json }},
    "productID": {{ product.id | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
    "category": {{ product.type | default: 'Sauna Hats' | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: brand | json }}
    },
    "image": [
      {%- for media in product_images limit: 8 -%}
        {{ media | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- else -%}
        {% if product.featured_media %}{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %}
      {%- endfor -%}
    ],
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "sku": {{ variant.sku | default: variant.id | json }},
        "url": {{ org_url | append: product.url | append: '?variant=' | append: variant.id | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | money_without_currency | json }},
        "priceValidUntil": {{ 'now' | date: '%Y' | plus: 1 | append: '-12-31' | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": {{ brand | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{% endif %}

{% if request.page_type == 'collection' and collection %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | truncate: 300 | json }},
    "url": {{ org_url | append: collection.url | json }},
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        {%- for product in collection.products limit: 24 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ org_url | append: product.url | json }},
          "name": {{ product.title | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
  </script>
{% endif %}

{% if request.page_type == 'article' and article %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
    "author": {
      "@type": "Organization",
      "name": {{ brand | json }},
      "url": {{ org_url | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ brand | json }},
      "url": {{ org_url | json }}
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ org_url | append: article.url | json }}
    },
    "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
    "articleSection": {{ blog.title | json }}
    {% if article.image %},
    "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
    {% endif %}
  }
  </script>
{% endif %}

{% if request.page_type == 'blog' and blog %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": {{ blog.title | json }},
    "url": {{ org_url | append: blog.url | json }},
    "publisher": {
      "@type": "Organization",
      "name": {{ brand | json }}
    },
    "blogPost": [
      {%- for article in blog.articles limit: 10 -%}
      {
        "@type": "BlogPosting",
        "headline": {{ article.title | json }},
        "url": {{ org_url | append: article.url | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{% endif %}
