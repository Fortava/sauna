{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_description = page_description | default: settings.seo_home_description | default: shop.description | strip_html | truncate: 160
  assign twitter_card = 'summary_large_image'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  if page_image
    assign og_image = page_image | image_url: width: 1200
  elsif settings.share_image != blank
    assign og_image = settings.share_image | image_url: width: 1200
  elsif request.page_type == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200
  endif
-%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} {{ settings.seo_separator | default: '–' }} {{ shop.name }}{% endunless -%}
</title>

{% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{% elsif request.page_type == 'index' and settings.seo_home_description != blank %}
  <meta name="description" content="{{ settings.seo_home_description | escape }}">
{% elsif shop.description != blank %}
  <meta name="description" content="{{ shop.description | strip_html | truncate: 160 | escape }}">
{% endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{% if og_image %}
  <meta property="og:image" content="http:{{ og_image }}">
  <meta property="og:image:secure_url" content="https:{{ og_image }}">
{% endif %}

{% if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{% endif %}

<meta name="twitter:card" content="{{ twitter_card }}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{% if og_image %}
  <meta name="twitter:image" content="https:{{ og_image }}">
{% endif %}

{% if template.name == 'password' or template.name == 'gift_card' %}
{% elsif request.page_type == 'search' and search.performed == false %}
  <meta name="robots" content="noindex">
{% endif %}
