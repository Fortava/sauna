<section class="page-content password-page" {{ section.shopify_attributes }}>
  <p class="eyebrow ember-text">{{ settings.brand_name | default: shop.name }}</p>
  <h1>{{ section.settings.heading | default: 'Opening soon.' }}</h1>
  {% if section.settings.subcopy != blank %}
    <p>{{ section.settings.subcopy }}</p>
  {% endif %}

  {% form 'storefront_password', class: 'password-form' %}
    <label class="visually-hidden" for="Password-{{ section.id }}">{{ 'general.password_page.password' | t }}</label>
    <input
      id="Password-{{ section.id }}"
      type="password"
      name="password"
      placeholder="{{ 'general.password_page.password' | t }}"
      required
    >
    <button class="button button-dark" type="submit">{{ 'general.password_page.submit' | t }}</button>
    {% if form.errors %}
      <p class="newsletter__error" role="alert">{{ form.errors | default_errors }}</p>
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon."
    },
    {
      "type": "textarea",
      "id": "subcopy",
      "label": "Supporting copy",
      "default": "BÖRN premium organic wool sauna hats. Enter the store password to continue."
    }
  ]
}
{% endschema %}
