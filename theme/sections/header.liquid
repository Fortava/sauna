<header class="site-header" id="top" {{ section.shopify_attributes }}>
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name }} home">
    {{ settings.brand_name | default: shop.name }}
  </a>

  <nav aria-label="Main navigation">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    {%- elsif section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {% if block.settings.label != blank %}
          <a href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {% endif %}
      {%- endfor -%}
    {%- endif -%}
  </nav>

  {% if section.settings.show_bag %}
    <button class="bag-button" type="button" data-cart-open aria-controls="cart" aria-expanded="false">
      {{ 'general.accessibility.cart' | t }}
      <span class="bag-count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
    </button>
  {% endif %}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Optional. If set, this replaces the link blocks below."
    },
    {
      "type": "checkbox",
      "id": "show_bag",
      "label": "Show bag button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
