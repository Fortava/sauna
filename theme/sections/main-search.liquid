<section class="page-content search-page" {{ section.shopify_attributes }}>
  <h1>{{ 'general.search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <button type="submit">{{ 'general.search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {% else %}
      <div class="product-grid">
        {% for item in search.results %}
          <a class="product-card" href="{{ item.url }}">
            <h2>{{ item.title }}</h2>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
