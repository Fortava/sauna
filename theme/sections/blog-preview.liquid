{%- liquid
  assign blog = blogs[section.settings.blog]
  if blog == blank
    assign blog = blogs.info
  endif
  assign article_limit = section.settings.limit | default: 3
-%}

{% if blog and blog.articles_count > 0 %}
  <section class="guides" id="guides" aria-labelledby="GuidesTitle-{{ section.id }}" {{ section.shopify_attributes }}>
    <div class="guides__intro reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow ember-text">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="GuidesTitle-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
      {% if section.settings.subcopy != blank %}
        <p>{{ section.settings.subcopy }}</p>
      {% endif %}
      {% if section.settings.show_all_label != blank %}
        <a class="line-link" href="{{ blog.url }}">{{ section.settings.show_all_label }}</a>
      {% endif %}
    </div>

    <div class="guides__grid">
      {% for article in blog.articles limit: article_limit %}
        <article class="guide-card reveal">
          <a href="{{ article.url }}" class="guide-card__media">
            {% if article.image %}
              {{ article.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '400,600,900',
                sizes: '(min-width: 900px) 30vw, 100vw',
                alt: article.image.alt | default: article.title
              }}
            {% endif %}
          </a>
          <div class="guide-card__copy">
            <p class="eyebrow">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {% if article.excerpt != blank %}
              <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Sauna guides",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select Sauna Guides (blogs/info)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sauna Guides"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Read the\nritual."
    },
    {
      "type": "textarea",
      "id": "subcopy",
      "label": "Supporting copy",
      "default": "Guides on heat, wool, care, and recovery — written for the serious sauna ritual."
    },
    {
      "type": "text",
      "id": "show_all_label",
      "label": "View all label",
      "default": "All guides →"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Sauna guides"
    }
  ]
}
{% endschema %}
