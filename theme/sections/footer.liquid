<footer class="site-footer" {{ section.shopify_attributes }}>
  <a class="footer-logo" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name }}</a>

  {% if section.settings.tagline != blank %}
    <p>{{ section.settings.tagline | newline_to_br }}</p>
  {% endif %}

  <div>
    {% if section.settings.show_contact %}
      {%- liquid
        assign contact_url = settings.contact_page
        if contact_url == blank
          assign contact_url = '/pages/contact'
        endif
      -%}
      <a href="{{ contact_url }}">{{ section.settings.contact_label | default: 'Contact' }}</a>
    {% endif %}
    {% if section.settings.show_instagram and settings.social_instagram != blank %}
      <a href="{{ settings.social_instagram }}" rel="noopener noreferrer" target="_blank">Instagram</a>
    {% endif %}
    {% if section.settings.show_blog %}
      {%- liquid
        assign guides = section.settings.blog
        if guides == blank
          assign guides = blogs.info
        endif
      -%}
      {% if guides != blank %}
        <a href="{{ guides.url }}">{{ section.settings.blog_label | default: 'Sauna Guides' }}</a>
      {% endif %}
    {% endif %}
    <small>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}</small>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Premium organic wool sauna hats.\nDesigned in Australia. Crafted in Ukraine."
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact page link",
      "default": true,
      "info": "Uses Theme settings → Contact page. No email is published on the storefront."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Contact"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_blog",
      "label": "Show blog link",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "blog_label",
      "label": "Blog link label",
      "default": "Sauna Guides"
    }
  ]
}
{% endschema %}
