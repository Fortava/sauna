<section class="collection-page" {{ section.shopify_attributes }}>
  <header class="collection-page__header">
    <h1>{{ section.settings.heading | default: 'Collections' }}</h1>
  </header>
  <div class="product-grid">
    {% for collection in collections %}
      {% if collection.handle == 'all' %}{% continue %}{% endif %}
      <a class="product-card" href="{{ collection.url }}">
        {% if collection.featured_image %}
          {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
        {% endif %}
        <h2>{{ collection.title }}</h2>
        <p>{{ collection.products_count }} products</p>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
